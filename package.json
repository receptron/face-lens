{
  "name": "face-lens-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w @receptron/face-lens && npm run build -w apps/demo",
    "dev": "npm run dev -w apps/demo",
    "publish:lib": "npm run build -w @receptron/face-lens && npm publish -w @receptron/face-lens"
  }
}
